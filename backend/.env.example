# Copy to backend/.env and fill in. Never commit .env.

# Required: where the care provider's SQLite database lives on your machine.
# The database is not part of this repo; it is opened read-only.
SOURCE_DB_PATH=/Users/you/Downloads/care_data.db

# Needed for LLM signal extraction, embeddings and the agent.
# Without it, `python -m app.ingest --extractor keyword` still builds everything offline.
OPENAI_API_KEY=

# Optional: models (names change over time; use any your key has access to)
# EXTRACTION_MODEL=gpt-5-mini        # runs once per visit
# AGENT_MODEL=gpt-5                  # answers questions
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=512
# EXTRACTION_CONCURRENCY=8

# Optional: other overrides
# INDEX_DB_PATH=data/agent_index.db   # derived store, rebuildable
# AS_OF=2025-11-16 23:59:59           # pin "today"; defaults to the latest visit
# TREND_ALERT_THRESHOLD=6
